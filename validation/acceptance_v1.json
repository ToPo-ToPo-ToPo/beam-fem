{
  "schema_version": "1.0",
  "release_target": "1.0.0rc1",
  "analysis": {
    "reference_relative_error_max": 0.005,
    "equilibrium_residual_max": 1e-8,
    "rotation_invariance_relative_error_max": 1e-10
  },
  "optimization": {
    "small_exact_relative_gap_max": 1e-9,
    "minimum_stochastic_seeds": 10,
