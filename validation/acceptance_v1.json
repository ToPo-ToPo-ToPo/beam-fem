    "require_final_fem_recheck": true
  },
  "performance": {
    "medium_speedup_target": 3.0,
    "require_machine_manifest": true,
    "require_large_case_checkpoint": true,
    "require_time_and_evaluation_limits": true
  },
  "safety": {
    "reject_nonfinite": true,
    "reject_zero_length": true,
    "reject_singular_mechanisms": true,
    "unsupported_checks_are_errors": true,
    "external_engineer_review_required": true
  }
}
